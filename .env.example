# HTTP server
PORT=3030
HOST=0.0.0.0
PUBLIC_APP_URL=https://hideseek.example.com

# Persistent SQLite directory inside the container
DATA_DIR=/data

# OpenStreetMap services (replace with your own/proxied endpoints if needed)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional comma-separated Overpass mirrors tried after transient 429/502/503/504 failures
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Upload safety limit; default is 5 MiB
MAX_KML_BYTES=5242880

# Logging: trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=info
